<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net6.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>SMARsvd</AssemblyName>
    <RootNamespace>SMARsvd.Desktop</RootNamespace>
    <ApplicationIcon>..\..\frontend\src\assets\icone-sistema.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Product>SMARtb SVD</Product>
    <Company>SMARAPD</Company>
    <Description>SMARtb SVD - Validação de Documentos</Description>
    <AllowedReferenceRelatedFileExtensions>.pdb</AllowedReferenceRelatedFileExtensions>
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="$(ApplicationIcon)" LogicalName="SMARsvd.ico" />
  </ItemGroup>

  <!-- O pacote do WebView2 sempre referencia a versão WPF do controle, que não é usada numa aplicação WinForms -->
  <Target Name="RemoverReferenciaWpfWebView2" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <Reference Remove="@(Reference)" Condition="'%(Filename)' == 'Microsoft.Web.WebView2.Wpf'" />
    </ItemGroup>
  </Target>

</Project>
